{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": ["src/**/*.ts", "!src/**/*.test.ts"],
  "reporters": ["json", "clear-text", "progress"],
  "jsonReporter": {
    "fileName": "../sample-report.json"
  },
  "thresholds": { "high": 80, "low": 60, "break": null },
  "timeoutMS": 2000
}
